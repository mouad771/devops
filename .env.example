# Exemple de configuration — copier vers .env et adapter
APP_NAME=Plateforme de gestion d'étudiants
ENVIRONMENT=development

# Base de données
# SQLite (par défaut, local) :
DATABASE_URL=sqlite:///./gestion_etudiants.db
# PostgreSQL (docker-compose / production) :
# DATABASE_URL=postgresql+psycopg2://app:app@db:5432/gestion_etudiants

# Sécurité JWT
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Compte administrateur initial (seed)
ADMIN_EMAIL=admin@ecole.ma
ADMIN_PASSWORD=admin1234
